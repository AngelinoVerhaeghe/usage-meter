{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the popover window may do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    "autostart:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://claude.ai/*" },
        { "url": "https://chatgpt.com/*" },
        { "url": "https://github.com/*" }
      ]
    }
  ]
}
