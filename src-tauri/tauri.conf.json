{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage Meter",
  "version": "0.1.0",
  "identifier": "com.comma.usagemeter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Usage Meter",
        "width": 380,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Claude and ChatGPT limits in your menu bar",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0OEM2M0Q3RUI5MzhDRkEKUldUNmpKUHIxMk9NOURVdXVzVXY3SEl0RllXb2JKb0wzOFpOMTduaWNzWmFtUW9Fd1FIYklBbXoK",
      "endpoints": ["https://github.com/nealwebdev/usage-meter/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
